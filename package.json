{
  "name": "@cmdforge/acp-launch",
  "version": "0.1.0",
  "description": "Start an ACP agent session, configure it, run a first prompt, and open it in the GitHub Copilot desktop app",
  "type": "module",
  "bin": {
    "acp-launch": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/launch.d.ts",
      "import": "./dist/launch.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "acp",
    "agent-client-protocol",
    "copilot",
    "github-copilot"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.1.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
