{
  "name": "@cmdforge/acp-launch",
  "version": "0.0.1",
  "description": "Start a GitHub Copilot ACP session with an agent, model, and first prompt, then hand it off to the GitHub Copilot desktop app",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "copilot",
    "github-copilot",
    "copilot-cli",
    "cli"
  ],
  "homepage": "https://github.com/cmdforge/acp-launch#readme",
  "bugs": {
    "url": "https://github.com/cmdforge/acp-launch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmdforge/acp-launch.git"
  },
  "author": "Fluttershy (https://github.com/Fluttershy)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "acp-launch": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/launch.d.ts",
      "import": "./dist/launch.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.1.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
